{
  "agent": {
    "dock": "right",
    "use_modifier_to_send": true,
    "thinking_display": "preview",
    "single_file_review": true,
    "default_model": {
      "enable_thinking": false,
      "model": "claude-haiku-4.5",
      "provider": "copilot_chat"
    },
    "default_profile": "write",
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3.8-flash",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "openai/gpt-5.6-sol",
        "enable_thinking": true
      }
    ],
    "inline_assistant_model": {
      "model": "gemini-3-flash-preview",
      "provider": "copilot_chat"
    }
  },
  "auto_indent_on_paste": true,
  "auto_update": true,
  "auto_update_extensions": {
    "docker-compose": false,
    "dockerfile": false
  },
  "base_keymap": "VSCode",
  "cursor_blink": true,
  "debugger": {
    "dock": "bottom"
  },
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed"
  },
  "file_types": {
    "hlsl": ["*.usf", "*.ush"],
    "yaml": ["*.yaml", "*.yml"]
  },
  "format_on_save": "off",
  "hard_tabs": false,
  "languages": {
    "JSON": {
      "tab_size": 2
    },
    "JSONC": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "GDScript": {
      "formatter": {
        "external": {
          "command": "gdscript-formatter"
        }
      }
    }
  },
  "lsp_document_colors": "background",
  "minimap": {
    "current_line_highlight": "line",
    "max_width_columns": 60,
    "show": "auto",
    "thumb": "always",
    "thumb_border": "none"
  },
  "remove_trailing_whitespace_on_save": false,
  "scrollbar": {
    "git_diff": true
  },
  "search": {
    "include_ignored": false
  },
  "soft_wrap": "editor_width",
  "tab_size": 4,
  "terminal": {
    "blinking": "on",
    "cursor_shape": "bar",
    "env": {
      "TERM": "xterm-256color"
    },
    "font_size": 12,
    "shell": "system",
    "toolbar": {
      "breadcrumbs": true
    }
  },
  "theme": {
    "dark": "Hemul's Tokyo Night Storm",
    "light": "One Light",
    "mode": "dark"
  },
  "ui_font_size": 15,
  "vim_mode": true
}
